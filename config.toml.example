# Honcho Configuration File
# Custom setup: MiniMax-M2.7 + local OMLX embedding (768-dim)
# Copy this to config.toml and fill in your own API keys.

# Application-level settings
[app]
LOG_LEVEL = "INFO"
SESSION_OBSERVERS_LIMIT = 10
GET_CONTEXT_MAX_TOKENS = 4000
MAX_FILE_SIZE = 5242880  # 5MB
MAX_MESSAGE_SIZE = 25000 # Characters
EMBED_MESSAGES = true
NAMESPACE = "honcho"

# Database settings
[db]
CONNECTION_URI = "postgresql+psycopg://postgres:postgres@localhost:5432/honcho"
SCHEMA = "public"
POOL_CLASS = "default"
POOL_PRE_PING = true
POOL_SIZE = 10
MAX_OVERFLOW = 20
POOL_TIMEOUT = 30  # seconds
POOL_RECYCLE = 300  # seconds
POOL_USE_LIFO = true
SQL_DEBUG = false
TRACING = false

# Authentication settings
[auth]
USE_AUTH = false
JWT_SECRET = "your-jwt-secret-here"  # Must be set if USE_AUTH is true

# Sentry settings
[sentry]
ENABLED = false
DSN = ""
RELEASE = ""
ENVIRONMENT = "development"
TRACES_SAMPLE_RATE = 0.1
PROFILES_SAMPLE_RATE = 0.1

# LLM settings
[llm]
DEFAULT_MAX_TOKENS = 4096
MAX_TOOL_OUTPUT_CHARS = 10000  # Max chars for tool output (~2500 tokens)
MAX_MESSAGE_CONTENT_CHARS = 2000  # Max chars per message in tool results

# API Keys for LLM providers
OPENAI_API_KEY = "your-openai-api-key-here"

# Embedding settings — using local OMLX (nomic-embed-text) on port 8000
[embedding]
VECTOR_DIMENSIONS = 768
MAX_INPUT_TOKENS = 8192
MAX_TOKENS_PER_REQUEST = 300000

[embedding.model_config]
transport = "openai"
model = "nomicai-embed-bf16"

[embedding.model_config.overrides]
base_url = "http://127.0.0.1:8000/v1"
# No api_key needed for local OMLX

# Deriver settings
[deriver]
ENABLED = true
WORKERS = 1
POLLING_SLEEP_INTERVAL_SECONDS = 10.0
FLUSH_ENABLED = false
DEDUPLICATE = true
LOG_OBSERVATIONS = false
MAX_INPUT_TOKENS = 32000
WORKING_REPRESENTATION_MAX_OBSERVATIONS = 100
REPRESENTATION_BATCH_MAX_TOKENS = 2048
# Force-process batches whose oldest item exceeds this many hours
STALE_BATCH_HOURS = 5

[deriver.model_config]
transport = "openai"
model = "MiniMax-M2.7"

[deriver.model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

# Peer card settings
[peer_card]
ENABLED = true

# Dialectic settings
[dialectic]
MAX_OUTPUT_TOKENS = 4096
MAX_INPUT_TOKENS = 32000
HISTORY_TOKEN_LIMIT = 4000
SESSION_HISTORY_MAX_TOKENS = 4000

# Per-level settings for reasoning levels
[dialectic.levels.minimal]
MAX_TOOL_ITERATIONS = 1
MAX_OUTPUT_TOKENS = 1024
TOOL_CHOICE = "any"

[dialectic.levels.minimal.model_config]
transport = "openai"
model = "MiniMax-M2.7"

[dialectic.levels.minimal.model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

[dialectic.levels.low]
MAX_TOOL_ITERATIONS = 5
MAX_OUTPUT_TOKENS = 2048
TOOL_CHOICE = "any"

[dialectic.levels.low.model_config]
transport = "openai"
model = "MiniMax-M2.7"

[dialectic.levels.low.model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

[dialectic.levels.medium]
MAX_TOOL_ITERATIONS = 2
MAX_OUTPUT_TOKENS = 4096

[dialectic.levels.medium.model_config]
transport = "openai"
model = "MiniMax-M2.7"

[dialectic.levels.medium.model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

[dialectic.levels.high]
MAX_TOOL_ITERATIONS = 4
MAX_OUTPUT_TOKENS = 4096

[dialectic.levels.high.model_config]
transport = "openai"
model = "MiniMax-M2.7"

[dialectic.levels.high.model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

[dialectic.levels.max]
MAX_TOOL_ITERATIONS = 10
MAX_OUTPUT_TOKENS = 4096

[dialectic.levels.max.model_config]
transport = "openai"
model = "MiniMax-M2.7"

[dialectic.levels.max.model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

# Summary settings
[summary]
ENABLED = true
MESSAGES_PER_SHORT_SUMMARY = 20
MESSAGES_PER_LONG_SUMMARY = 60
MAX_TOKENS_SHORT = 1024
MAX_TOKENS_LONG = 2048

[summary.model_config]
transport = "openai"
model = "MiniMax-M2.7"

[summary.model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

# Dream settings
[dream]
ENABLED = true
DOCUMENT_THRESHOLD = 50
IDLE_TIMEOUT_MINUTES = 60
MIN_HOURS_BETWEEN_DREAMS = 8
ENABLED_TYPES = ["omni"]
MAX_TOOL_ITERATIONS = 5
HISTORY_TOKEN_LIMIT = 4000

[dream.deduction_model_config]
transport = "openai"
model = "MiniMax-M2.7"

[dream.deduction_model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

[dream.induction_model_config]
transport = "openai"
model = "MiniMax-M2.7"

[dream.induction_model_config.overrides]
base_url = "https://api.minimaxi.com/v1"
api_key = "your-minimax-api-key-here"

# Surprisal-based sampling subsystem
[dream.surprisal]
ENABLED = false
TREE_TYPE = "kdtree"
TREE_K = 5
SAMPLING_STRATEGY = "recent"
SAMPLE_SIZE = 200
TOP_PERCENT_SURPRISAL = 0.10
MIN_HIGH_SURPRISAL_FOR_REPLACE = 10
INCLUDE_LEVELS = ["explicit", "deductive"]

# Webhook settings
[webhook]
SECRET = "your-webhook-secret-here"
MAX_WORKSPACE_LIMIT = 10

# Prometheus metrics settings
[metrics]
ENABLED = false

# CloudEvents telemetry settings
[telemetry]
ENABLED = false
BATCH_SIZE = 100
FLUSH_INTERVAL_SECONDS = 1.0
FLUSH_THRESHOLD = 50
MAX_RETRIES = 3
MAX_BUFFER_SIZE = 10000

# Cache settings
[cache]
ENABLED = true
URL = "redis://localhost:6379/0?suppress=true"
DEFAULT_TTL_SECONDS = 300
DEFAULT_LOCK_TTL_SECONDS = 5

# Vector store settings
[vector_store]
TYPE = "pgvector"
MIGRATED = true
NAMESPACE = "honcho"
DIMENSIONS = 768
LANCEDB_PATH = "./lancedb_data"
RECONCILIATION_INTERVAL_SECONDS = 300
